table Ventes
	lineageTag: 4530d223-ab2a-4a0d-9111-aee194003748

	measure 'CA HT' = CALCULATE ( SUM ( Ventes[MontantHT] ), Ventes[Statut] <> "Annulée" )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 323202a6-b3d4-4137-818b-a47d39778ec5

	measure 'Nb commandes' = CALCULATE ( DISTINCTCOUNT ( Ventes[NumCommande] ), Ventes[Statut] <> "Annulée" )
		formatString: 0
		lineageTag: 3c3e1ec4-7b52-4e5e-89a9-eabc0c883910

	measure 'Panier moyen' = DIVIDE ( [CA HT], [Nb commandes] )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 3fcc2e08-1ed2-4235-a4d5-a3153e3a8f9b

	measure 'Taux d''annulation' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( Ventes[NumCommande] ), Ventes[Statut] = "Annulée" ), DISTINCTCOUNT ( Ventes[NumCommande] ) )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: bcce0841-d5f6-4700-831a-71a3477a6c23

	measure 'CA HT SPLY' = ```
			
			CALCULATE ( 
			    SUM ( Ventes[MontantHT] ), 
			    Ventes[Statut] <> "Annulée", 
			    SAMEPERIODLASTYEAR(Calendrier[Date])
			)
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 59ec5934-fc2c-4e69-a6a7-f91163a4ca93

		annotation PBI_FormatHint = {"currencyCulture":"fr-FR"}

	measure 'EVO CA HT VS LY' =
			
			([CA HT] - [CA HT SPLY]) / [CA HT SPLY]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d851550c-2823-49b2-90fd-2a8a394789be

