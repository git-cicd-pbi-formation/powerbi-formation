	partition Ventes = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        Web.Contents("https://raw.githubusercontent.com",
				            [RelativePath = "git-cicd-pbi-formation/donnees-formation/main/" & Environnement & "/ventes.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {
				        {"NumCommande", type text}, {"DateCommande", type date}, {"ProduitId", Int64.Type},
				        {"Region", type text}, {"Canal", type text}, {"Quantite", Int64.Type},
				        {"MontantHT", Currency.Type}, {"Statut", type text}, {"Environnement", type text}}, "en-US")
				in
				    Types

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

